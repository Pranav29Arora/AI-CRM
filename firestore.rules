rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for all AI-CRM collections
    // Paste this rule into: https://console.firebase.google.com/project/ai-crm-f73a5/firestore/rules
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
